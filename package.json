{
  "name": "sidequest",
  "private": true,
  "version": "1.0.23",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-env.mjs",
    "prebuild": "node scripts/sync-env.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "apk": "bash scripts/build-apk.sh",
    "check:quests": "node scripts/check-quests.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "screenshots": "node scripts/screenshot-app.mjs",
    "fetch:events": "node scripts/fetch-events.mjs",
    "bump": "bash scripts/bump-version.sh",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@supabase/supabase-js": "^2.112.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.17",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "puppeteer-core": "^25.7.0",
    "sharp": "^0.35.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
