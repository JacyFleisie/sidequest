# Public client-side values — these ship inside every web build and APK anyway,
# so they are safe to commit. `npm run dev` / `npm run build` auto-generates
# .env from this file when it's missing. Never put real secrets here.
VITE_SUPABASE_URL=https://qhfdmueezkhyuyqtrwad.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_-grpFPx5dQDLMiHdx1xggQ_bfMUIB_l
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEMDJ01NdEYNnQuJ
# Optional: free Ticketmaster Discovery API key (developer.ticketmaster.com →
# "Create an app"). Two consumers use it:
#   VITE_TICKETMASTER_API_KEY — the app's LIVE event source, queried straight
#     from the browser at launch (Ticketmaster enables CORS for this API).
#     Public like the keys above, so it's safe to commit.
#   TICKETMASTER_API_KEY     — the offline snapshot generator
#     (scripts/fetch-events.mjs, `npm run fetch:events`). Server-side only.
# Paste your real key into .env (gitignored) to enable either.
VITE_TICKETMASTER_API_KEY=
TICKETMASTER_API_KEY=
